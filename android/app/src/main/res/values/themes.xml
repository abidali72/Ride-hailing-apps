<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base App Theme - Dark -->
    <style name="Theme.Zaara" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryContainer">@color/green_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_green</item>
        <item name="colorSecondary">@color/green_accent</item>
        <item name="colorSurface">@color/bg_dark</item>
        <item name="colorSurfaceVariant">@color/bg_dark_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.Zaara.Splash" parent="Theme.Zaara">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <!-- Button Styles -->
    <style name="ZaaraButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/green_primary</item>
    </style>

    <style name="ZaaraButton.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="strokeColor">@color/green_primary</item>
        <item name="android:textColor">@color/green_primary</item>
    </style>

    <!-- Card Style -->
    <style name="ZaaraCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/bg_dark_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Input Field Style -->
    <style name="ZaaraInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/zaara_input_stroke</item>
        <item name="hintTextColor">@color/green_primary</item>
    </style>

    <!-- Bottom Sheet Style -->
    <style name="ZaaraBottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/bg_dark_card</item>
        <item name="shapeAppearance">@style/ZaaraBottomSheetShape</item>
    </style>

    <style name="ZaaraBottomSheetShape" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <!-- Text Styles -->
    <style name="TextTitle">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextSubtitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextCaption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>
</resources>
